<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>graphWidget</class>
 <widget class="QWidget" name="graphWidget">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>900</width>
    <height>650</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Grafos No Dirigidos</string>
  </property>
  <property name="styleSheet">
   <string notr="true">/* =========================
   CONTENEDOR / VENTANA
   ========================= */
QDialog, QWidget#graphWidget {
    background-color: #1e1e1e;
    border: 1px solid #303030;
    border-radius: 12px;
    font-family: &quot;Segoe UI&quot;;
    color: #f0f0f0;
}

/* =========================
   ETIQUETAS
   ========================= */
QLabel {
    color: #e0e0e0;
    font-weight: 500;
    background: transparent;
}

/* =========================
   CAJAS DE TEXTO Y EDICIÓN
   ========================= */
QLineEdit, QPlainTextEdit {
    background-color: #2b2b2b;
    color: #ffffff;
    border: 2px solid #404040;
    border-radius: 8px;
    padding: 8px;
    selection-background-color: #3d8bfd;
}

QLineEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #3d8bfd;
    background-color: #333333;
}

QLineEdit:disabled, QPlainTextEdit:read-only {
    background-color: #252525;
    color: #a0a0a0;
}

/* =========================
   COMBOBOX (DESPLEGABLES)
   ========================= */
QComboBox {
    background-color: #2b2b2b;
    color: #ffffff;
    border: 2px solid #404040;
    border-radius: 8px;
    padding: 6px 12px;
    min-height: 20px;
}

QComboBox:hover {
    border: 2px solid #5a5a5a;
}

QComboBox:focus {
    border: 2px solid #3d8bfd;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    border-left: 1px solid #404040;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox QAbstractItemView {
    background-color: #2b2b2b;
    color: #ffffff;
    border: 1px solid #404040;
    selection-background-color: #3d8bfd;
    selection-color: #ffffff;
    padding: 4px;
}

/* =========================
   GROUP BOX (SECCIONES)
   ========================= */
QGroupBox {
    background-color: #242424;
    border: 1px solid #3a3a3a;
    border-radius: 8px;
    margin-top: 24px;
    font-weight: bold;
    color: #3d8bfd;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 8px;
    background-color: #1e1e1e;
    border: 1px solid #3a3a3a;
    border-radius: 4px;
    left: 10px;
}

/* =========================
   BOTONES
   ========================= */
QPushButton {
    background-color: transparent;
    color: white;
    border: 2px solid #5a5a5a;
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #333333;
    border-color: #3d8bfd;
}

QPushButton:pressed {
    background-color: #252525;
}

/* =========================
   TAB WIDGET (SOLUCIÓN ANCHO TEXTO)
   ========================= */
QTabWidget::pane {
    border: 1px solid #3a3a3a;
    background-color: #242424;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background-color: #1e1e1e;
    color: #a0a0a0;
    border: 1px solid #3a3a3a;
    /* Relleno cómodo: 8px arriba/abajo, 18px izquierda/derecha */
    padding: 8px 18px; 
    margin-right: 4px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-weight: 500;
    /* Garantiza que quepan los títulos más largos */
    min-width: 160px;
}

QTabBar::tab:selected {
    background-color: #242424;
    color: #3d8bfd;
    border-bottom-color: #242424;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background-color: #2b2b2b;
    color: #ffffff;
}
/* =========================
   TABLAS (MATRIZ Y LISTAS)
   ========================= */
QTableWidget {
    background-color: #2b2b2b;
    color: #ffffff;
    gridline-color: #3a3a3a;
    border: 1px solid #404040;
    border-radius: 6px;
}

QHeaderView::section {
    background-color: #1e1e1e;
    color: #e0e0e0;
    padding: 6px;
    border: 1px solid #3a3a3a;
    font-weight: bold;
}

QTableWidget QTableCornerButton::section {
    background-color: #1e1e1e;
    border: 1px solid #3a3a3a;
}

/* =========================
   GRAPHICS VIEW (ÁREA DE DIBUJO)
   ========================= */
QGraphicsView {
    background-color: #181818;
    border: 2px solid #3a3a3a;
    border-radius: 8px;
}
/* =========================
   TOOLTIP
   ========================= */
QToolTip {
    background-color: #2b2b2b;
    color: white;
    border: 1px solid #3d8bfd;
    padding: 5px;
    border-radius: 4px;
}</string>
  </property>
  <layout class="QVBoxLayout" name="mainVerticalLayout">
   <item>
    <widget class="QLabel" name="lblTitle">
     <property name="font">
      <font>
       <weight>62</weight>
       <bold>true</bold>
      </font>
     </property>
     <property name="text">
      <string>Grafos no dirigidos</string>
     </property>
     <property name="alignment">
      <set>Qt::AlignCenter</set>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="contentHorizontalLayout" stretch="1,3">
     <item>
      <layout class="QVBoxLayout" name="controlsLayout">
       <item>
        <widget class="QGroupBox" name="grpVertices">
         <property name="title">
          <string>Vértices</string>
         </property>
         <layout class="QVBoxLayout" name="verticalLayoutVertices">
          <item>
           <widget class="QLineEdit" name="txtVertex">
            <property name="placeholderText">
             <string>Nombre del vértice</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btnAddVertex">
            <property name="text">
             <string>Agregar vértice</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QComboBox" name="cmbVertex"/>
          </item>
          <item>
           <widget class="QPushButton" name="btnDeleteVertex">
            <property name="text">
             <string>Eliminar vértice</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grpEdges">
         <property name="title">
          <string>Arcos</string>
         </property>
         <layout class="QGridLayout" name="gridLayoutEdges">
          <item row="2" column="0" colspan="2">
           <widget class="QPushButton" name="btnAddEdge">
            <property name="text">
             <string>Agregar arco</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="lblDestination">
            <property name="text">
             <string>Vértice 2</string>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QComboBox" name="cmbDestination"/>
          </item>
          <item row="3" column="0" colspan="2">
           <widget class="QPushButton" name="btnDeleteEdge">
            <property name="text">
             <string>Eliminar arco</string>
            </property>
           </widget>
          </item>
          <item row="0" column="0">
           <widget class="QLabel" name="lblOrigin">
            <property name="text">
             <string>Vértice 1</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="cmbOrigin"/>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <spacer name="verticalSpacer">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </item>
     <item>
      <widget class="QTabWidget" name="tabWidgetRepresentations">
       <property name="minimumSize">
        <size>
         <width>550</width>
         <height>0</height>
        </size>
       </property>
       <property name="styleSheet">
        <string notr="true">background-color: rgb(0, 0, 0);</string>
       </property>
       <property name="currentIndex">
        <number>3</number>
       </property>
       <widget class="QWidget" name="tabVisual">
        <attribute name="title">
         <string>Representación visual</string>
        </attribute>
        <layout class="QVBoxLayout" name="verticalLayoutTab1">
         <item>
          <widget class="QGraphicsView" name="graphicsViewGraph"/>
         </item>
         <item>
          <widget class="QPushButton" name="btnRedrawGraph">
           <property name="text">
            <string>Redibujar grafo</string>
           </property>
          </widget>
         </item>
        </layout>
       </widget>
       <widget class="QWidget" name="tabAdjacencyMatrix">
        <attribute name="title">
         <string>Matriz de adyacencia</string>
        </attribute>
        <layout class="QVBoxLayout" name="verticalLayoutTab2">
         <item>
          <widget class="QTableWidget" name="tblAdjacencyMatrix">
           <property name="editTriggers">
            <set>QAbstractItemView::NoEditTriggers</set>
           </property>
          </widget>
         </item>
        </layout>
       </widget>
       <widget class="QWidget" name="tabAdjacencyList">
        <attribute name="title">
         <string>Lista de adyacencia</string>
        </attribute>
        <layout class="QVBoxLayout" name="verticalLayoutTab3">
         <item>
          <widget class="QPlainTextEdit" name="txtAdjacencyList">
           <property name="readOnly">
            <bool>true</bool>
           </property>
          </widget>
         </item>
        </layout>
       </widget>
       <widget class="QWidget" name="tabEdges">
        <attribute name="title">
         <string>Lista de arcos</string>
        </attribute>
        <layout class="QVBoxLayout" name="verticalLayoutTab4">
         <item>
          <widget class="QTableWidget" name="tblEdges">
           <property name="editTriggers">
            <set>QAbstractItemView::NoEditTriggers</set>
           </property>
           <column>
            <property name="text">
             <string>Vértice 1</string>
            </property>
           </column>
           <column>
            <property name="text">
             <string>Vértice 2</string>
            </property>
           </column>
          </widget>
         </item>
        </layout>
       </widget>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="statusHorizontalLayout">
     <item>
      <widget class="QLabel" name="lblGraphStatus">
       <property name="text">
        <string>Vértices: 0 | Arcos: 0</string>
       </property>
      </widget>
     </item>
     <item>
      <spacer name="horizontalSpacer">
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
       <property name="sizeHint" stdset="0">
        <size>
         <width>40</width>
         <height>20</height>
        </size>
       </property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="btnClearGraph">
       <property name="text">
        <string>Limpiar grafo</string>
       </property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
